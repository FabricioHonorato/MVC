@model Aluno
@{
    ViewData["title"] = "Cadastrar novo Aluno";
}

<h1>Cadastrar novo Aluno</h1>

<div asp-validation-summary="All" class="erro"></div>

<form asp-action="Criar" method="post">
    <p>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome" class="erro"></span>
    </p>
    <p>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="erro"></span>
    </p>
    <p>
        <label asp-for="Idade"></label>
        <input asp-for="Idade" type="number" />
        <span asp-validation-for="Idade" class="erro"></span>
    </p>
    <button type="submit">Salvar</button>
</form>