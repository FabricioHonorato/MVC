@model List<Aluno>
@{
    ViewData["title"] = "Listagem de Alunos";
}

<h1>Listagem Geral de Alunos</h1>

<table> // Início da tabela que exibirá os alunos
  <tr>
    <th>Id</th>
    <th>Nome</th>
    <th>Email</th>
    <th>Idade</th>
    <th></th>
  </tr>
  @foreach ( Aluno a in Model)
  {
    <tr>
      <td>@a.Id</td>
      <td>@a.Nome</td>
      <td>@a.Email</td>
      <td>@a.Idade</td>
      <td>
        <a asp-action="Detalhes" asp-route-id="@a.Id">Ver</a>
      </td>
      
    </tr>        
  }
</table>

